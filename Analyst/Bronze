-- =========================================================
-- Cek jumlah data
-- =========================================================
SELECT 'employees'      AS tabel, COUNT(*) AS total_baris FROM bronze.employees
UNION ALL SELECT 'departments',    COUNT(*) FROM bronze.departments
UNION ALL SELECT 'attendance',     COUNT(*) FROM bronze.attendance
UNION ALL SELECT 'performance',    COUNT(*) FROM bronze.performance
UNION ALL SELECT 'salary_history', COUNT(*) FROM bronze.salary_history;
-- Ekspektasi: 500 / 15 / 3.000 / 600 / 1.500
GO

