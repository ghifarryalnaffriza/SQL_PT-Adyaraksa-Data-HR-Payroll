-- =========================================================
-- bronze.employees
-- =========================================================
-- PK: NULL & duplikat
SELECT emp_id, COUNT(*) AS jml
FROM bronze.employees
GROUP BY emp_id
HAVING COUNT(*) > 1 OR emp_id IS NULL;

-- Missing values kolom
SELECT
    SUM(CASE WHEN full_name IS NULL OR full_name = '' THEN 1 ELSE 0 END) AS null_nama,
    SUM(CASE WHEN dept_id IS NULL OR dept_id = '' THEN 1 ELSE 0 END)     AS null_dept,
    SUM(CASE WHEN hire_date IS NULL THEN 1 ELSE 0 END)                   AS null_hire,
    SUM(CASE WHEN birth_date IS NULL THEN 1 ELSE 0 END)                  AS null_birth,
    SUM(CASE WHEN status IS NULL OR status = '' THEN 1 ELSE 0 END)       AS null_status
FROM bronze.employees;

-- Unwanted spaces
SELECT emp_id
FROM bronze.employees
WHERE full_name <> TRIM(full_name)
   OR position  <> TRIM(position)
   OR city      <> TRIM(city);

-- Sebaran teks jabatan (dasar pemetaan level_jabatan)
SELECT position, COUNT(*) AS jml FROM bronze.employees GROUP BY position;

-- Outlier / invalid value: umur & tanggal tidak wajar
SELECT emp_id, birth_date, hire_date
FROM bronze.employees
WHERE birth_date > GETDATE()
   OR hire_date  > GETDATE()
   OR DATEDIFF(YEAR, birth_date, GETDATE()) NOT BETWEEN 17 AND 70;

-- Structural error: direkrut sebelum lahir / direkrut di bawah umur
SELECT emp_id, birth_date, hire_date,
       DATEDIFF(YEAR, birth_date, hire_date) AS umur_saat_direkrut
FROM bronze.employees
WHERE hire_date < birth_date
   OR DATEDIFF(YEAR, birth_date, hire_date) < 17;

-- Referential integrity: karyawan -> departemen
SELECT DISTINCT e.dept_id
FROM bronze.employees e
WHERE NULLIF(TRIM(e.dept_id), '') IS NOT NULL
  AND e.dept_id NOT IN (SELECT dept_id FROM bronze.departments);

-- Referential integrity: manager_id harus karyawan yang terdaftar (self-join)
SELECT DISTINCT e.manager_id
FROM bronze.employees e
WHERE NULLIF(TRIM(e.manager_id), '') IS NOT NULL
  AND e.manager_id NOT IN (SELECT emp_id FROM bronze.employees);

-- Business logic: karyawan tidak boleh jadi manajer dirinya sendiri
SELECT emp_id, manager_id FROM bronze.employees WHERE emp_id = manager_id;

-- =========================================================
-- bronze.departments
-- =========================================================
-- PK: NULL & duplikat
SELECT dept_id, COUNT(*) AS jml
FROM bronze.departments
GROUP BY dept_id
HAVING COUNT(*) > 1 OR dept_id IS NULL;

-- Outlier: anggaran tidak wajar
SELECT * FROM bronze.departments WHERE annual_budget_idr <= 0;

-- Referential integrity: kepala departemen harus karyawan terdaftar
SELECT DISTINCT d.head_emp_id
FROM bronze.departments d
WHERE NULLIF(TRIM(d.head_emp_id), '') IS NOT NULL
  AND d.head_emp_id NOT IN (SELECT emp_id FROM bronze.employees);

-- =========================================================
-- bronze.attendance
-- =========================================================
-- PK: NULL & duplikat
SELECT record_id, COUNT(*) AS jml
FROM bronze.attendance
GROUP BY record_id
HAVING COUNT(*) > 1 OR record_id IS NULL;

-- Duplikat logis: satu karyawan tidak boleh punya 2 record di hari sama
SELECT emp_id, date, COUNT(*) AS jml
FROM bronze.attendance
GROUP BY emp_id, date
HAVING COUNT(*) > 1;

-- Missing values: pola check_out kosong per status (DQ #4)
SELECT
    status,
    COUNT(*)                                            AS jml,
    SUM(CASE WHEN check_out IS NULL THEN 1 ELSE 0 END)  AS check_out_kosong,
    SUM(CASE WHEN work_hours IS NULL THEN 1 ELSE 0 END) AS work_hours_kosong
