-- Structural error: check_out sebelum check_in
SELECT record_id, check_in, check_out
FROM bronze.attendance
WHERE check_out < check_in;

-- Outlier: jam kerja tidak wajar
SELECT * FROM bronze.attendance WHERE work_hours < 0 OR work_hours > 16;

-- Referential integrity: absensi -> karyawan
SELECT DISTINCT a.emp_id
FROM bronze.attendance a
WHERE a.emp_id NOT IN (SELECT emp_id FROM bronze.employees);

-- Business logic: absensi sebelum tanggal masuk kerja
SELECT a.record_id, a.date, e.hire_date
FROM bronze.attendance a
JOIN bronze.employees e ON a.emp_id = e.emp_id
WHERE a.date < e.hire_date;

