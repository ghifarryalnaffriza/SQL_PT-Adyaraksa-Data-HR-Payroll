-- =========================================================
-- Create schema
-- =========================================================
IF NOT EXISTS (SELECT 1 FROM sys.schemas WHERE name = 'silver')
    EXEC('CREATE SCHEMA silver');
GO

-- =========================================================
-- Create table
-- =========================================================
IF OBJECT_ID('silver.departments', 'U') IS NOT NULL
    DROP TABLE silver.departments;
GO

CREATE TABLE silver.departments (
    dept_id           VARCHAR(10),
    dept_name         VARCHAR(80),
    division          VARCHAR(40),
    location          VARCHAR(50),
    head_emp_id       VARCHAR(20),
    annual_budget_idr BIGINT,
    is_synthetic      BIT, 
    dwh_create_date   DATETIME2 DEFAULT GETDATE()
);
GO

IF OBJECT_ID('silver.employees', 'U') IS NOT NULL
    DROP TABLE silver.employees;
GO

CREATE TABLE silver.employees (
    emp_id          VARCHAR(20),
    full_name       NVARCHAR(100),
    email           VARCHAR(120),
    dept_id         VARCHAR(10),
    position        VARCHAR(80),
    level_jabatan   VARCHAR(20),
    hire_date       DATE,
    hire_year       INT,
    tenure_years    DECIMAL(5,2),
    birth_date      DATE,
    age             INT,
    gender          VARCHAR(10),
    marital_status  VARCHAR(20),
    education       VARCHAR(10),
    city            VARCHAR(50),
    status          VARCHAR(20),
    manager_id      VARCHAR(20),
    dwh_create_date DATETIME2 DEFAULT GETDATE()
);
GO

IF OBJECT_ID('silver.attendance', 'U') IS NOT NULL
    DROP TABLE silver.attendance;
GO

CREATE TABLE silver.attendance (
    record_id        VARCHAR(20),
    emp_id           VARCHAR(20),
    att_date         DATE,
    check_in         TIME(0),
    check_out        TIME(0),
    work_hours       DECIMAL(5,2),
    status           VARCHAR(20),
    is_hari_kerja    BIT,
    is_lupa_clockout BIT,
    dwh_create_date  DATETIME2 DEFAULT GETDATE()
);
GO

IF OBJECT_ID('silver.performance', 'U') IS NOT NULL
    DROP TABLE silver.performance;
GO

CREATE TABLE silver.performance (
    review_id       VARCHAR(20),
    emp_id          VARCHAR(20),
    review_period   VARCHAR(20),
    review_year     INT,
    review_cycle    VARCHAR(10),
    review_date     DATE,
    overall_score   DECIMAL(3,1),
    kpi_score       DECIMAL(3,1),
    attitude_score  DECIMAL(3,1),
    reviewer_id     VARCHAR(20),
    dwh_create_date DATETIME2 DEFAULT GETDATE()
);
GO

IF OBJECT_ID('silver.salary_history', 'U') IS NOT NULL
    DROP TABLE silver.salary_history;
GO

CREATE TABLE silver.salary_history (
    record_id          VARCHAR(20),
    emp_id             VARCHAR(20),
    effective_date_raw VARCHAR(20),
    effective_date     DATE,
    base_salary_idr    BIGINT,
    allowances_idr     BIGINT,
    total_idr          BIGINT,
    change_reason      VARCHAR(30),
    dwh_create_date    DATETIME2 DEFAULT GETDATE()
);
GO

