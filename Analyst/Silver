-- =========================================================
-- silver.salary_history
-- DQ #2 parse 3 format tanggal | DQ #3 buang duplikat double-entry
-- =========================================================
TRUNCATE TABLE silver.salary_history;

WITH parsed AS (
    SELECT
        TRIM(record_id)      AS record_id,
        TRIM(emp_id)         AS emp_id,
        TRIM(effective_date) AS effective_date_raw,
        -- Deteksi format per baris lewat pola, bukan tebak-tebakan:
        -- DD/MM/YYYY (style 103) dan DD-MM-YYYY (style 105) sama-sama
        -- day-first, jadi salah pilih style menukar hari dengan bulan
        CASE
            WHEN effective_date LIKE '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'
                THEN TRY_CONVERT(DATE, effective_date, 23)    -- ISO
            WHEN effective_date LIKE '[0-9][0-9]/[0-9][0-9]/[0-9][0-9][0-9][0-9]'
                THEN TRY_CONVERT(DATE, effective_date, 103)   -- DD/MM/YYYY
            WHEN effective_date LIKE '[0-9][0-9]-[0-9][0-9]-[0-9][0-9][0-9][0-9]'
                THEN TRY_CONVERT(DATE, effective_date, 105)   -- DD-MM-YYYY
        END                  AS effective_date,
        base_salary_idr,
        allowances_idr,
        total_idr,
        TRIM(change_reason)  AS change_reason
    FROM bronze.salary_history
),
dedup AS (
    SELECT *,
        -- Double-entry: baris pertama (record_id terkecil) dipertahankan
        ROW_NUMBER() OVER (PARTITION BY emp_id, effective_date
                           ORDER BY record_id) AS rn
    FROM parsed
)
INSERT INTO silver.salary_history (
    record_id, emp_id, effective_date_raw, effective_date,
    base_salary_idr, allowances_idr, total_idr, change_reason
)
SELECT
    record_id, emp_id, effective_date_raw, effective_date,
    base_salary_idr, allowances_idr, total_idr, change_reason
FROM dedup
WHERE rn = 1;   -- buang 8 duplikat -> 1.492 baris
GO

