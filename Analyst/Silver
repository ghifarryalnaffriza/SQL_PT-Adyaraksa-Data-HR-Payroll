-- silver.performance
-- =========================================================
TRUNCATE TABLE silver.performance;

INSERT INTO silver.performance (
    review_id, emp_id, review_period, review_year, review_cycle,
    review_date, overall_score, kpi_score, attitude_score, reviewer_id
)
SELECT
    TRIM(review_id),
    TRIM(emp_id),
    TRIM(review_period),
    TRY_CAST(LEFT(TRIM(review_period), 4) AS INT),   -- format periode: 'YYYY-...'
    -- Siklus review: mid-year vs annual, dibedakan karena polanya beda
    CASE WHEN LOWER(review_period) LIKE '%mid%' THEN 'mid' ELSE 'annual' END,
    review_date,
    overall_score,
    kpi_score,
    attitude_score,
    NULLIF(TRIM(reviewer_id), '')
FROM bronze.performance;
