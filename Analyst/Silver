    CASE
        WHEN effective_date LIKE '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]' THEN 'ISO (YYYY-MM-DD)'
        WHEN effective_date LIKE '[0-9][0-9]/[0-9][0-9]/[0-9][0-9][0-9][0-9]' THEN 'DD/MM/YYYY'
        WHEN effective_date LIKE '[0-9][0-9]-[0-9][0-9]-[0-9][0-9][0-9][0-9]' THEN 'DD-MM-YYYY'
        ELSE 'lainnya'
    END;

