-- =========================================================
-- silver.attendance
-- =========================================================
TRUNCATE TABLE silver.attendance;

INSERT INTO silver.attendance (
    record_id, emp_id, att_date, check_in, check_out,
    work_hours, status, is_hari_kerja, is_lupa_clockout
)
SELECT
    TRIM(record_id),
    TRIM(emp_id),
    date,
    check_in,
    check_out,
    work_hours,
    TRIM(status),
    -- Hari kerja efektif: absent/leave/holiday tidak dihitung
    CASE WHEN TRIM(status) IN ('present','late','wfh') THEN 1 ELSE 0 END,
    -- DQ #4: check_out kosong hanya bermasalah bila statusnya hari kerja.
    -- Pada absent/leave/holiday, kosong justru benar.
    CASE WHEN TRIM(status) IN ('present','late','wfh') AND check_out IS NULL
         THEN 1 ELSE 0 END
FROM bronze.attendance;
GO
