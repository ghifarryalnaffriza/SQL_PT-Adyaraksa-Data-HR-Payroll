-- =========================================================
-- silver.employees
-- =========================================================
TRUNCATE TABLE silver.employees;

INSERT INTO silver.employees (
    emp_id, full_name, email, dept_id, position, level_jabatan,
    hire_date, hire_year, tenure_years, birth_date, age, gender,
    marital_status, education, city, status, manager_id
)
SELECT
    TRIM(emp_id),
    TRIM(full_name),
    LOWER(TRIM(email)),                                  -- email disamakan lowercase
    -- DQ #1: kosong bukan berarti data hilang — mereka karyawan
    -- onboarding yang belum ditempatkan
    COALESCE(NULLIF(TRIM(dept_id), ''), 'UNASSIGNED'),
    TRIM(position),
    -- Level jabatan diturunkan dari teks jabatan; urutan CASE penting
    -- karena 'Senior Manager' harus masuk Manager, bukan Senior
    CASE
        WHEN LOWER(position) LIKE '%head%'    OR LOWER(position) LIKE '%director%'
          OR LOWER(position) LIKE '%vp%'      OR LOWER(position) LIKE '%chief%'
             THEN '4-Leadership'
        WHEN LOWER(position) LIKE '%manager%' OR LOWER(position) LIKE '%lead%'
             THEN '3-Manager/Lead'
        WHEN LOWER(position) LIKE '%senior%'
             THEN '2-Senior'
        ELSE '1-Staff/Junior'
    END,
    hire_date,
    YEAR(hire_date),
    -- Tanggal snapshot dipatok 2025-01-01 (bukan GETDATE) supaya angka
    -- tenure & umur tetap sama setiap kali script dijalankan ulang —
    -- hasil analisis jadi reproducible
    CAST(DATEDIFF(DAY, hire_date, '2025-01-01') / 365.25 AS DECIMAL(5,2)),
    birth_date,
    DATEDIFF(YEAR, birth_date, '2025-01-01')
        - CASE WHEN DATEADD(YEAR, DATEDIFF(YEAR, birth_date, '2025-01-01'), birth_date) > '2025-01-01'
               THEN 1 ELSE 0 END,
    TRIM(gender),
    TRIM(marital_status),
    TRIM(education),
    TRIM(city),
    TRIM(status),
    NULLIF(TRIM(manager_id), '')                         -- kosong = pucuk pimpinan
FROM bronze.employees;
